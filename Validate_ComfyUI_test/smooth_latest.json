{
  "plugin_name": "smooth",
  "description": "This module is used to smooth the data",
  "version": "1.0.0",
  "author": "PMT",
  "functions": [
    {
      "function_name": "smooth_2d",
      "display_name": "Smooth 2d",
      "description": "Smooth 2D data",
      "input": {
        "source": [
          {
            "name": "data",
            "type": "2D",
            "description": "Input data",
            "options": {}
          }
        ],
        "args": [
          {
            "name": "sigma",
            "type": "FLOAT",
            "description": "sigma",
            "options": {
              "min": 0,
              "max": 50,
              "step": 0.1,
              "default": 0.3
            }
          }
        ]
      },
      "output": [
        {
          "name": "data",
          "type": "2D",
          "description": "Output data from smooth_2d"
        }
      ]
    },
    {
      "function_name": "smooth_3d",
      "display_name": "Smooth 3d",
      "description": "Smooth 3D data",
      "input": {
        "source": [
          {
            "name": "data",
            "type": "3D",
            "description": "Input data",
            "options": {}
          }
        ],
        "args": [
          {
            "name": "sigma",
            "type": "FLOAT",
            "description": "sigma",
            "options": {
              "min": 0,
              "max": 50,
              "step": 0.1,
              "default": 0.3
            }
          }
        ]
      },
      "output": [
        {
          "name": "data",
          "type": "3D",
          "description": "Output data from smooth_3d"
        }
      ]
    }
  ]
}