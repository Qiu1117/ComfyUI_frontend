{
	"plugin_name": "smooth",
	"description": "smooth the any input data, no matter 2D or 3D",
	"version": "0.1.0",
	"author": "PMT",
	"functions": [
		{
			"function_name": "smooth_2d",
			"display_name": "Smooth (2D)",
			"description": "smooth 2D data",
			"input": {
				"source": [
					{
						"name": "data",
						"type": "2D",
						"description": "2D data"
					}
				],
				"args": [
					{
						"name": "sigma",
						"type": "FLOAT",
						"description": "hyperparameter of gaussian smooth",
						"options": {
							"default": 0.3,
							"min": 0,
							"max": 50,
							"step": 0.1
						}
					}
				]
			},
			"output": [
				{
					"name": "data",
					"type": "2D",
					"description": "smoothed 2D or 3D data, output same size as input"
				},
				{
					"name": "test_txt",
					"type": "STRING",
					"description": "output some sentences"
				}
			]
		}
	]
}
